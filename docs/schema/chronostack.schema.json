{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Asmodeus14/ChronoStack/blob/main/docs/schema/chronostack.schema.json",
  "title": "chronostack.yml",
  "description": "ChronoStack configuration: triggers and barriers for `chronostack advance`.",
  "type": "object",
  "required": [
    "version"
  ],
  "additionalProperties": false,
  "$defs": {
    "duration": {
      "type": "string",
      "pattern": "^([0-9]+(w|d|h|m|s|ms))+$|^[0-9]+$",
      "description": "e.g. 90s, 25h, 14d, 1h30m, 500ms"
    },
    "exec": {
      "type": "object",
      "required": [
        "service",
        "command"
      ],
      "additionalProperties": false,
      "properties": {
        "service": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "http": {
      "type": "object",
      "required": [
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "description": "Must be reachable from the host running the CLI. service://<service>:<port>/path goes to a port listed in expose: (chronostack.yml)."
        },
        "method": {
          "type": "string",
          "default": "POST"
        },
        "status": {
          "type": "integer",
          "description": "Expected status; default any 2xx."
        },
        "body": {
          "type": "string",
          "description": "Request body (sent as application/json unless content_type is set)."
        },
        "content_type": {
          "type": "string"
        }
      }
    },
    "sql": {
      "type": "object",
      "required": [
        "service",
        "query"
      ],
      "additionalProperties": false,
      "properties": {
        "service": {
          "type": "string"
        },
        "query": {
          "type": "string",
          "description": "Without `equals`: must return t/true/1 when satisfied."
        },
        "user": {
          "type": "string"
        },
        "database": {
          "type": "string"
        },
        "equals": {
          "type": "string",
          "description": "Expected single-cell result, compared as text."
        }
      }
    },
    "redis": {
      "type": "object",
      "required": [
        "service",
        "command",
        "equals"
      ],
      "additionalProperties": false,
      "properties": {
        "service": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "equals": {
          "type": "string"
        }
      }
    },
    "bullmq": {
      "type": "object",
      "required": [
        "service",
        "queues"
      ],
      "additionalProperties": false,
      "description": "Satisfied when these BullMQ (or Bull) queues have nothing waiting, paused, running, prioritized, or delayed and already due.",
      "properties": {
        "service": {
          "type": "string",
          "description": "The Redis service the queues live in."
        },
        "queues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "prefix": {
          "type": "string",
          "minLength": 1,
          "default": "bull",
          "description": "The queues' key prefix (BullMQ's `prefix` option)."
        }
      }
    },
    "sidekiq": {
      "type": "object",
      "required": [
        "service"
      ],
      "additionalProperties": false,
      "description": "Satisfied when Sidekiq has nothing queued, no scheduled or retry job already due, and no job running (confirmed by a heartbeat after the queues look empty).",
      "properties": {
        "service": {
          "type": "string",
          "description": "The Redis service Sidekiq uses."
        },
        "namespace": {
          "type": "string",
          "description": "A redis-namespace prefix, if the app uses one."
        }
      }
    }
  },
  "properties": {
    "version": {
      "const": 1
    },
    "advance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_jump": {
          "$ref": "#/$defs/duration",
          "description": "Largest single clock jump. Default: 1h if pg_cron is detected, otherwise unlimited."
        },
        "dwell": {
          "$ref": "#/$defs/duration",
          "description": "Wait after each step/sub-step when no barrier is configured."
        },
        "barrier_timeout": {
          "$ref": "#/$defs/duration",
          "default": "30s"
        }
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "exec"
            ]
          },
          {
            "required": [
              "http"
            ]
          }
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "schedule": {
            "type": "object",
            "required": [
              "every"
            ],
            "additionalProperties": false,
            "description": "Run at each virtual occurrence (UTC). Omit to run after every --step.",
            "properties": {
              "every": {
                "$ref": "#/$defs/duration"
              },
              "at": {
                "type": "string",
                "pattern": "^[0-2][0-9]:[0-5][0-9](:[0-5][0-9])?$",
                "description": "UTC time of day, must fall inside one period."
              }
            }
          },
          "exec": {
            "$ref": "#/$defs/exec"
          },
          "http": {
            "$ref": "#/$defs/http"
          },
          "timeout": {
            "$ref": "#/$defs/duration",
            "default": "60s"
          }
        }
      }
    },
    "barriers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "sql"
            ]
          },
          {
            "required": [
              "redis"
            ]
          },
          {
            "required": [
              "exec"
            ]
          },
          {
            "required": [
              "http"
            ]
          },
          {
            "required": [
              "bullmq"
            ]
          },
          {
            "required": [
              "sidekiq"
            ]
          }
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sql": {
            "$ref": "#/$defs/sql"
          },
          "redis": {
            "$ref": "#/$defs/redis"
          },
          "exec": {
            "$ref": "#/$defs/exec"
          },
          "http": {
            "$ref": "#/$defs/http"
          },
          "timeout": {
            "$ref": "#/$defs/duration"
          },
          "bullmq": {
            "$ref": "#/$defs/bullmq"
          },
          "sidekiq": {
            "$ref": "#/$defs/sidekiq"
          },
          "settle": {
            "$ref": "#/$defs/duration",
            "description": "Wait this long at each stop before the first check (for schedulers that enqueue on their next poll, such as sidekiq-cron or Clockwork)."
          }
        }
      }
    },
    "proxies": {
      "type": "array",
      "description": "HTTP egress targets routed through the clockd fault proxy, so outages can be scheduled in virtual time.",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "name",
          "upstream"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "upstream": {
            "type": "string",
            "pattern": "^http://[^/?#@]+/?$",
            "description": "http://host[:port] the requests really go to, inside the Compose network."
          },
          "env": {
            "type": "object",
            "description": "service: VARIABLE. Each variable (a URL starting with `upstream`) is pointed at the proxy in the ChronoStack copy.",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "description": "Limits for `chronostack mcp` (AI agents).",
      "properties": {
        "max_advance": {
          "$ref": "#/$defs/duration",
          "description": "Largest single clock_advance an agent may request, and the largest total advance of a scenario_run, counted from the scenario's start (default 400d)."
        },
        "max_wall": {
          "$ref": "#/$defs/duration",
          "description": "Longest real time one MCP tool call may run before it is stopped (default 10m)."
        }
      }
    },
    "expose": {
      "type": "array",
      "description": "Container ports of the ChronoStack copy to publish on 127.0.0.1, so tools on the host (your browser, HTTP triggers, scenario http steps) can reach them. Use service://<service>:<port>/path in URLs.",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[^:]+:[0-9]+$",
            "description": "<service>:<port>, on a host port Docker picks, e.g. app:3000"
          },
          {
            "type": "object",
            "required": [
              "service",
              "port"
            ],
            "additionalProperties": false,
            "properties": {
              "service": {
                "type": "string"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "host_port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535,
                "description": "Fixed host port (127.0.0.1 only)"
              }
            }
          }
        ]
      }
    }
  }
}
